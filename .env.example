# Local development — copy to .env.local and fill values:
#   Copy-Item .env.example .env.local
#
# Deploy templates (import into each platform):
#   .env.vercel.example  → Vercel TEST / staging
#   .env.fly.example     → Fly.io PRODUCTION secrets
#   fly.toml [build.args] → NEXT_PUBLIC_* for production Docker build

# Public site URL used for canonical links, Open Graph, sitemap, and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# test | production (optional — useful for feature flags later)
APP_ENV=development

# --- Sanity CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Optional read token for private datasets / drafts
SANITY_API_READ_TOKEN=

# --- Supabase (ops: reservations, contact, newsletter, orders) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (choose one for staff inbox) ---
# Option A: Formspree endpoint (staff only; guest confirmations need Resend)
# FORMSPREE_ENDPOINT=https://formspree.io/f/your-id

# Option B: Resend (required for guest confirmation emails)
RESEND_API_KEY=re_xxx
CONTACT_TO_EMAIL=owner@example.com
CONTACT_FROM_EMAIL=Foodtuck <onboarding@resend.dev>

# --- PayOS (Phase 3 — Vietnamese payments) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
