# =============================================================================
# Fly.io — PRODUCTION (server secrets only)
# NEXT_PUBLIC_* are set in fly.toml [build.args] (baked in at Docker build).
#
# Set secrets (PowerShell):
#   fly secrets set `
#     SANITY_API_READ_TOKEN="..." `
#     SUPABASE_SERVICE_ROLE_KEY="..." `
#     RESEND_API_KEY="..." `
#     CONTACT_TO_EMAIL="..." `
#     CONTACT_FROM_EMAIL="PML Food <hello@yourdomain.com>" `
#     PAYOS_CLIENT_ID="..." `
#     PAYOS_API_KEY="..." `
#     PAYOS_CHECKSUM_KEY="..."
#
# Or import from this file (skip empty / commented lines):
#   Get-Content .env.fly.example | Where-Object { $_ -match '^[A-Z].+=' -and $_ -notmatch '=$' } | ForEach-Object { fly secrets set $_ }
# =============================================================================

APP_ENV=production

SANITY_API_READ_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=

# FORMSPREE_ENDPOINT=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=PML Food <onboarding@resend.dev>

# PayOS live keys on Fly only
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
