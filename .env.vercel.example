# =============================================================================
# Vercel — TEST / STAGING
# Import: Vercel Dashboard → Project → Settings → Environment Variables →
#         "Import .env" (paste this file), or:
#   vercel env pull .env.local
#   vercel env add <NAME>
#
# Assign ALL vars to Preview + Production on the Vercel project (this project
# is the test environment — Vercel "Production" here = staging site).
# =============================================================================

# Use your Vercel production URL after first deploy, e.g. https://pml-food.vercel.app
NEXT_PUBLIC_SITE_URL=https://pml-food.vercel.app
APP_ENV=test

# --- Sanity CMS (optional: use a "staging" dataset for safer CMS edits) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=8aj7sksi
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://jnjmldoqrobzgexjxkcl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Email ---
